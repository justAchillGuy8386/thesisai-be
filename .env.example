# Application Configuration
PROJECT_NAME="ThesisAI Backend"
API_V1_STR="/api"
PORT=8000
HOST="0.0.0.0"
DEBUG=True

# CORS Settings (JSON list of allowed origins)
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL Database (with pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=thesisai
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thesisai

# Ollama & Local AI Models
OLLAMA_BASE_URL="http://localhost:11434"
LLM_MODEL="qwen2.5:7b"
EMBEDDING_MODEL="bge-m3"
WHISPER_MODEL="base"

# Local Storage & Lifecycle (Privacy-First)
STORAGE_DIR="D:/DoAnTotNghiep/thesisai-be/storage"
AUDIO_RETENTION_HOURS=24
AUTO_DELETE_RAW_DOCS=True
MAX_UPLOAD_SIZE_MB=50
MAX_AUDIO_SIZE_MB=10
